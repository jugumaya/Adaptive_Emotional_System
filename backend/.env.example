# Copy this file to `.env` and edit the values for your local setup.
# The backend reads these via pydantic-settings on startup.

# Database — choose ONE:
#   PostgreSQL (recommended for production):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aee_db

#   SQLite (zero-setup local dev):
# DATABASE_URL=sqlite:///./aee.db

# Auth — REPLACE before deploying anywhere real.
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256
